{
	"name": "stars-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"build:docs": "STARS_OUT=../docs/next VITE_DB_JSON=../db.json vite build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"dompurify": "3.4.16",
		"marked": "18.0.14",
		"sql.js-httpvfs": "0.8.12"
	},
	"devDependencies": {
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.50.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.4",
		"bits-ui": "2.19.4",
		"cn": "0.4.0",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.2"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
